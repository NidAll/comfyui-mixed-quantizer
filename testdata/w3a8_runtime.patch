+"""AsymW3A8Int8Layout -- 3-bit extension format (comfyui_wxa8_quantizer)."""
+from __future__ import annotations
+
+import dataclasses
+
+import torch
+
+from .base import BaseLayoutParams, QuantizedLayout, QuantizedTensor, register_layout_class, register_layout_op
+
+
+def _fit_codebook8(normalized, iterations=25, sample_size=300000):
+    samples = normalized.flatten()
+    if samples.numel() > sample_size:
+        gen = torch.Generator(device=samples.device).manual_seed(0)
+        idx = torch.randint(0, samples.numel(), (sample_size,), device=samples.device, generator=gen)
+        samples = samples[idx]
+    samples = samples.float()
+    cb = torch.quantile(samples, torch.linspace(0, 1, 8, device=samples.device))
+    for _ in range(iterations):
+        asg = (samples.unsqueeze(-1) - cb).abs().argmin(-1)
+        upd = cb.clone()
+        for i in range(8):
+            sel = asg == i
+            if sel.any():
+                upd[i] = samples[sel].mean()
+        cb = upd
+    return cb.contiguous()
+
+
+def _assign8(normalized, cb):
+    best = (normalized - cb[0]).abs()
+    idx = torch.zeros_like(normalized, dtype=torch.int32)
+    for i in range(1, 8):
+        d = (normalized - cb[i]).abs()
+        closer = d < best
+        best = torch.where(closer, d, best)
+        idx = torch.where(closer, i, idx)
+    return idx
+
+
+def pack_w3(codes):
+    n, k = codes.shape
+    c = codes.reshape(n, k // 8, 8).to(torch.int32)
+    c0, c1, c2, c3, c4, c5, c6, c7 = c.unbind(-1)
+    b0 = c0 | (c1 << 3) | (c2 << 6)
+    b1 = (c2 >> 2) | (c3 << 1) | (c4 << 4) | (c5 << 7)
+    b2 = (c5 >> 1) | (c6 << 2) | (c7 << 5)
+    return torch.stack([b0, b1, b2], dim=-1).reshape(n, k * 3 // 8).to(torch.int8).contiguous()
+
+
+def unpack_w3(packed):
+    n, nb = packed.shape
+    k = nb * 8 // 3
+    p = packed.to(torch.int32).reshape(n, nb // 3, 3) & 0xFF
+    b0, b1, b2 = p.unbind(-1)
+    c0 = b0 & 0x7
+    c1 = (b0 >> 3) & 0x7
+    c2 = ((b0 >> 6) | (b1 << 2)) & 0x7
+    c3 = (b1 >> 1) & 0x7
+    c4 = (b1 >> 4) & 0x7
+    c5 = ((b1 >> 7) | (b2 << 1)) & 0x7
+    c6 = (b2 >> 2) & 0x7
+    c7 = (b2 >> 5) & 0x7
+    return torch.stack([c0, c1, c2, c3, c4, c5, c6, c7], dim=-1).reshape(n, k)
+
+
+def quantize_w3a8_weight(weight, group_size=16, convrot_groupsize=256):
+    from comfy_kitchen.backends.eager.w4a8_int8 import validate_w4a8_weight_shape
+    from comfy_kitchen.tensor.int8_utils import _build_hadamard, _rotate_weight
+    validate_w4a8_weight_shape(weight, group_size, convrot_groupsize)
+    h = _build_hadamard(convrot_groupsize, device=weight.device, dtype=weight.dtype)
+    w = _rotate_weight(weight, h, convrot_groupsize)
+    n, k = w.shape
+    groups = k // group_size
+    grouped = w.float().view(n, groups, group_size)
+    gs = grouped.abs().amax(dim=-1, keepdim=True).clamp(min=1e-8)
+    cb = _fit_codebook8(grouped / gs)
+    q = _assign8(grouped / gs, cb)
+    for _ in range(3):
+        qc = cb[q]
+        gs = ((grouped * qc).sum(-1, keepdim=True) / (qc * qc).sum(-1, keepdim=True).clamp(min=1e-8)).clamp(min=1e-8)
+        q = _assign8(grouped / gs, cb)
+    shifted = cb[q] * gs
+    s_channel = (shifted.abs().amax(dim=(1, 2)) / 127.0).clamp(min=1e-8)
+    s_rel = (gs.squeeze(-1) / s_channel.unsqueeze(1)).float().contiguous().to(torch.float8_e4m3fn)
+    levels = (cb.view(1, 1, 8) * s_rel.float().unsqueeze(-1)).round_().clamp_(-127, 127)
+    target = grouped / s_channel.view(-1, 1, 1)
+    best = (target - levels[..., 0:1].expand_as(grouped)).abs()
+    idx = torch.zeros_like(grouped, dtype=torch.int32)
+    for i in range(1, 8):
+        d = (target - levels[..., i:i + 1].expand_as(grouped)).abs()
+        closer = d < best
+        best = torch.where(closer, d, best)
+        idx = torch.where(closer, i, idx)
+    return pack_w3(idx.reshape(n, k)), s_rel, s_channel.float().contiguous(), cb.float().contiguous()
+
+
+def dequantize_w3a8_weight(packed, s_rel, s_channel, codebook, group_size=16, convrot_groupsize=256, output_dtype=torch.bfloat16):
+    from comfy_kitchen.tensor.int8_utils import _build_hadamard, _rotate_weight
+    n, nb = packed.shape
+    k = nb * 8 // 3
+    codes = unpack_w3(packed)
+    values = codebook.to(dtype=torch.float32)[codes]
+    values = values.view(n, k // group_size, group_size) * s_rel.float().unsqueeze(-1)
+    i8 = values.view(n, k).round().clamp_(-127, 127).to(torch.int8)
+    w = i8.float().view(n, k // group_size, group_size) * s_channel.float().view(n, 1, 1)
+    h = _build_hadamard(convrot_groupsize, device=packed.device, dtype=torch.float32)
+    return _rotate_weight(w.view(n, k), h, convrot_groupsize).to(output_dtype)
+
+
+class AsymW3A8Int8Layout(QuantizedLayout):
+    """Grouped 3-bit W3A8 extension layout (decodes through the INT8 path)."""
+    MIN_SM_VERSION = (8, 0)
+    QUANTIZES_INPUT = False
+
+    @dataclasses.dataclass(frozen=True)
+    class Params(BaseLayoutParams):
+        s_channel: torch.Tensor | None = None
+        codebook: torch.Tensor | None = None
+        group_size: int = 16
+        convrot_groupsize: int = 256
+        transposed: bool = False
+
+        def _tensor_fields(self):
+            return ["scale", "s_channel"]
+
+    @classmethod
+    def quantize(cls, tensor, group_size=16, convrot_groupsize=256, **kwargs):
+        packed, s_rel, s_ch, cb = quantize_w3a8_weight(tensor, group_size, convrot_groupsize)
+        return packed, cls.Params(scale=s_rel, s_channel=s_ch, codebook=cb,
+                                  orig_dtype=tensor.dtype, orig_shape=tuple(tensor.shape),
+                                  group_size=group_size, convrot_groupsize=convrot_groupsize)
+
+    @classmethod
+    def dequantize(cls, qdata, params):
+        return dequantize_w3a8_weight(qdata, params.scale, params.s_channel, params.codebook,
+                                      group_size=params.group_size,
+                                      convrot_groupsize=params.convrot_groupsize,
+                                      output_dtype=params.orig_dtype)
+
+    @classmethod
+    def state_dict_tensors(cls, qdata, params):
+        return {"": qdata, "_s_rel": params.scale, "_s_channel": params.s_channel,
+                "_codebook": params.codebook}
+
+
+def _handle_w3a8int8_linear(qt, args, kwargs):
+    input_tensor, weight = args[0], args[1]
+    bias = args[2] if len(args) > 2 else None
+    if not isinstance(weight, QuantizedTensor) or weight._layout_cls != "AsymW3A8Int8Layout":
+        return torch.nn.functional.linear(input_tensor, weight.dequantize() if isinstance(weight, QuantizedTensor) else weight, bias)
+    params = weight._params
+    w = dequantize_w3a8_weight(weight._qdata, params.scale, params.s_channel, params.codebook,
+                               params.group_size, params.convrot_groupsize, input_tensor.dtype)
+    return torch.nn.functional.linear(input_tensor, w, bias).to(params.orig_dtype)
+
+
+register_layout_class("AsymW3A8Int8Layout", AsymW3A8Int8Layout)
+register_layout_op(torch.ops.aten.linear.default, AsymW3A8Int8Layout)(_handle_w3a8int8_linear)
